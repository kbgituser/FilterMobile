<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Mobile.ContentPages.ClientCreatePage" Title="Create Client">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Create Client" FontSize="24" FontAttributes="Bold" />
      <Entry Placeholder="Enter name" Text="{Binding ClientDto.Name}" />
      <Entry Placeholder="Enter system" Text="{Binding ClientDto.System}" />
      <Entry Placeholder="Enter address" Text="{Binding ClientDto.Address}" />
      <Entry Placeholder="Enter phone" Text="{Binding ClientDto.Phone}" />
      <Editor Placeholder="Enter notes" HeightRequest="100" Text="{Binding ClientDto.Notes}" />

      <Button Text="Создать" Command="{Binding CreateClientCommand}" />
      <Button Text="Отмена" Clicked="OnCancelClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
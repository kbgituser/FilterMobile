<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Mobile.ContentPages.ClientsPage" Title="ClientsPage">
  <Grid Padding="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Label Grid.Row="0" Text="Клиенты" FontSize="24" FontAttributes="Bold" />
    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
    <HorizontalStackLayout Grid.Row="2" Spacing="12">
      <Button Text="Обновить" Command="{Binding LoadClientsCommand}" />
      <Button Text="Создать" Clicked="OnCreateClicked" />
    </HorizontalStackLayout>
    <CollectionView Grid.Row="3" ItemsSource="{Binding Clients}" ItemsLayout="VerticalList">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Frame BorderColor="#ccc" Margin="5" Padding="10" CornerRadius="8">
            <VerticalStackLayout>
              <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
              <Label Text="{Binding System}" FontAttributes="Italic" />
              <Label Text="{Binding Address}" />
              <Label Text="{Binding Phone}" />
              <Label Text="{Binding Notes}" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>
          </Frame>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <Button Grid.Row="4" Text="Назад" Clicked="OnBackClicked" />
  </Grid>
</ContentPage>
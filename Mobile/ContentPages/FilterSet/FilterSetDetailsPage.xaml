<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.ContentPages.FilterSetDetailsPage"
             Title="Filter Set Details">
    <ContentPage.Content>
        <StackLayout Padding="20" Spacing="10">
            <!-- Example UI, adjust as needed -->
            <Label Text="Filter Set Details" FontAttributes="Bold" FontSize="24" HorizontalOptions="Center" />
            <Label Text="Name:" />
            <Label Text="{Binding FilterSet.Name}" />
            <Label Text="Type:" />
            <Label Text="{Binding FilterSet.FilterType}" />
            <Label Text="Description:" />
            <Label Text="{Binding FilterSet.Description}" />
            <Label Text="Price:" />
            <Label Text="{Binding FilterSet.Price}" />
            <Label Text="Period:" />
            <Label Text="{Binding FilterSet.Period}" />
            <Button Text="Back" Clicked="OnBackClicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
